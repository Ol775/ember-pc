<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The installer is built for .NET Framework 4.8, which every supported Windows 10 and 11 already has, so it runs on a PC that has
    no .NET 8 yet. It carries the Ember files and Microsoft's two runtime installers inside itself (see scripts\build-release.ps1).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EmberSetup</AssemblyName>
    <RootNamespace>Ember.Setup</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Ember.App\Assets\ember.ico</ApplicationIcon>
    <Product>Ember Setup</Product>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\TERMS.md" LogicalName="TERMS.md" />
    <EmbeddedResource Include="..\..\docs\images\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')" />
    <EmbeddedResource Include="..\..\third-party\prereqs\dotnet-desktop-runtime-x64.exe" LogicalName="dotnet-runtime.exe" Condition="Exists('..\..\third-party\prereqs\dotnet-desktop-runtime-x64.exe')" />
    <EmbeddedResource Include="..\..\third-party\prereqs\vc_redist.x64.exe" LogicalName="vc-redist.exe" Condition="Exists('..\..\third-party\prereqs\vc_redist.x64.exe')" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
