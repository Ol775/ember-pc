<Application x:Class="Ember.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark theme. Muted text #9c9189 on panel #1d1916 is the lowest contrast allowed (AA). -->
        <SolidColorBrush x:Key="WindowBrush" Color="#141110" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#181412" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1d1916" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2e2824" />
        <SolidColorBrush x:Key="TextBrush" Color="#f3ece6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9c9189" />
        <SolidColorBrush x:Key="AccentBrush" Color="#ff7a2f" />
        <SolidColorBrush x:Key="GpuBrush" Color="#4ea8de" />
        <SolidColorBrush x:Key="BannerBrush" Color="#2b1c12" />

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panels are GroupBoxes: a real labelled control (header = label) that screen readers expose as a group. -->
        <Style x:Key="Panel" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="False"
                                                  TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontSize="13" />
                                <ContentPresenter Margin="0,6,0,0" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Application.Resources>
</Application>
