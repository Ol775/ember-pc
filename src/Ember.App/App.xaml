<Application x:Class="Ember.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark theme. Muted text #9c9189 on panel #1d1916 is the lowest contrast allowed (AA). -->
        <SolidColorBrush x:Key="WindowBrush" Color="#141110" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#181412" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1d1916" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2e2824" />
        <SolidColorBrush x:Key="TextBrush" Color="#f3ece6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9c9189" />
        <SolidColorBrush x:Key="AccentBrush" Color="#ff7a2f" />
        <SolidColorBrush x:Key="GpuBrush" Color="#4ea8de" />
        <SolidColorBrush x:Key="BannerBrush" Color="#2b1c12" />

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panels are GroupBoxes: a real labelled control (header = label) that screen readers expose as a group. -->
        <Style x:Key="Panel" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="False"
                                                  TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontSize="13" />
                                <ContentPresenter Margin="0,6,0,0" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation: a real RadioButton group, so it is keyboard operable and announced as selected. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="8,0,8,4" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bar" Padding="12,8" CornerRadius="6" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Application.Resources>
</Application>
