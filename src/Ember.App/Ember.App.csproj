<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\ember.ico</ApplicationIcon>
    <!-- No background GC thread: the app is small and a short blocking collection is cheaper than the extra thread and memory. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <!-- WinForms is here only for the tray icon: keep its names out of the WPF code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- OpenRGB, fetched by scripts/fetch-openrgb.ps1, ships in an "OpenRGB" folder next to the app. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third-party\openrgb\OpenRGB.exe')">
    <Content Include="..\..\third-party\openrgb\**\*" Link="OpenRGB\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Corsair's iCUE SDK libraries (newer and older), fetched by scripts/fetch-icue-sdk.ps1, ships in an "iCUE" folder next to the app. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third-party\icue\iCUESDK.x64_2019.dll')">
    <Content Include="..\..\third-party\icue\*.dll" Link="iCUE\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ember.Core\Ember.Core.csproj" />
    <ProjectReference Include="..\Ember.Lighting\Ember.Lighting.csproj" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <Resource Include="Assets\ember.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="..\..\ROADMAP.md" LogicalName="ROADMAP.md" />
    <EmbeddedResource Include="..\..\TERMS.md" LogicalName="TERMS.md" />
    <EmbeddedResource Include="..\..\PRIVACY.md" LogicalName="PRIVACY.md" />
    <EmbeddedResource Include="..\..\THIRD-PARTY.md" LogicalName="THIRD-PARTY.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
  </ItemGroup>
</Project>
