<Window x:Class="Ember.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ember.App"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Ember" Icon="Assets/ember.ico" Width="1100" Height="720" MinWidth="820" MinHeight="560"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,24">
                <Path Data="M12,3 C13,7 17,8 17,13 A5,5 0 0 1 7,13 C7,11 8,10 9,9 C9,11 10,12 11,12 C11,9 10,7 12,3 Z"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Width="24" Height="24"
                      Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Ember" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20,0,20,20">
                <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="ConnectionLabel" Text="{Binding ConnectionText}" Foreground="{DynamicResource MutedBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding BuildLabel}" Foreground="{DynamicResource MutedBrush}" Margin="20,0,20,12" />
            <Button DockPanel.Dock="Bottom" Content="Restart as administrator" Click="OnRestartAsAdmin" Margin="20,0,20,12"
                    Style="{StaticResource ActionButton}" Visibility="{Binding NotElevatedVisibility}"
                    ToolTip="Needed to close fan-control programs that run as administrator." />
            <StackPanel VerticalAlignment="Top">
                <RadioButton x:Name="NavDashboard" GroupName="Nav" Content="Dashboard" IsChecked="True"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavFans" GroupName="Nav" Content="Fans"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavLights" GroupName="Nav" Content="Lights"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavDevices" GroupName="Nav" Content="Devices"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavSettings" GroupName="Nav" Content="Settings"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
            </StackPanel>
        </DockPanel>

        <!-- Dashboard -->
        <ScrollViewer x:Name="DashboardPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24">
                <DockPanel Margin="0,0,0,16">
                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14"
                            Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeChipText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>

                <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding DriverBannerVisibility}">
                    <TextBlock x:Name="BannerLabel" Text="{Binding DriverBannerText}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <TextBlock Text="Sensor data is stale" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding StaleNoteVisibility}" AutomationProperties.LiveSetting="Polite" />

                <UniformGrid Columns="4" Margin="-6,0,-6,16">
                    <GroupBox Header="CPU" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding CpuText, StringFormat=CPU temperature {0}}">
                        <StackPanel><TextBlock Text="{Binding CpuText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding CpuSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                    <GroupBox Header="GPU" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding GpuText, StringFormat=GPU temperature {0}}">
                        <StackPanel><TextBlock Text="{Binding GpuText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource GpuBrush}" /><TextBlock Text="{Binding GpuSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                    <GroupBox Header="Motherboard" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding MotherboardText, StringFormat=Motherboard temperature {0}}">
                        <StackPanel><TextBlock Text="{Binding MotherboardText}" Style="{StaticResource StatValue}" /><TextBlock Text="{Binding MotherboardSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                    <GroupBox Header="Fans (average)" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding FanAverageText, StringFormat=Fans average {0}}">
                        <StackPanel><TextBlock Text="{Binding FanAverageText}" Style="{StaticResource StatValue}" /><TextBlock Text="{Binding FansSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                </UniformGrid>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="{Binding ChartTitle}" Style="{StaticResource Panel}" Margin="0,0,16,0">
                    <AutomationProperties.Name>
                        <MultiBinding StringFormat="Temperature history chart, last 10 minutes. CPU now {0}, GPU now {1}">
                            <Binding Path="CpuText" />
                            <Binding Path="GpuText" />
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Rectangle Width="14" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="CPU" Margin="6,0,16,0" />
                            <Rectangle Width="14" Height="3" Fill="{DynamicResource GpuBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU" Margin="6,0,0,0" />
                        </StackPanel>
                        <Canvas Height="260" ClipToBounds="True" SizeChanged="OnChartSizeChanged">
                            <Polyline Points="{Binding CpuLine}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" />
                            <Polyline Points="{Binding GpuLine}" Stroke="{DynamicResource GpuBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" />
                        </Canvas>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Fans" Style="{StaticResource Panel}" AutomationProperties.Name="Fans">
                    <StackPanel>
                        <TextBlock Text="No fan readings" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding NoFansVisibility}" />
                        <ItemsControl ItemsSource="{Binding Fans}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,6" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelBorderBrush}"
                                                     BorderThickness="0" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding Name}"
                                                     AutomationProperties.HelpText="{Binding RpmText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RpmText}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Fans -->
        <ScrollViewer x:Name="FansPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <StackPanel Margin="24">
                <TextBlock Text="Fans" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"
                           AutomationProperties.HeadingLevel="Level2" />

                <TextBlock Text="{Binding FansPage.Message}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                           Visibility="{Binding FansMessageVisibility}" AutomationProperties.LiveSetting="Polite" />

                <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding CompetitorVisibility}">
                    <StackPanel>
                        <TextBlock x:Name="CompetitorLabel" Text="{Binding FansPage.CompetitorWarning}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Close these apps" Click="OnCloseCompetitors" Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,0" AutomationProperties.Name="Close the detected fan-control apps" />
                            <Button Content="Restart Ember as administrator" Click="OnRestartAsAdmin" Style="{StaticResource ActionButton}"
                                    Margin="0" Visibility="{Binding NotElevatedVisibility}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding SafetyVisibility}">
                    <TextBlock Text="{Binding FansPage.SafetyNote}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <GroupBox Header="Mode" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Fan mode">
                    <StackPanel>
                        <Border Style="{StaticResource SegmentTrack}">
                        <ItemsControl ItemsSource="{Binding FansPage.Modes}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="FanMode" Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}"
                                                 IsEnabled="{Binding Enabled}" Tag="{Binding Mode}" Click="OnModePicked"
                                                 Style="{StaticResource Segment}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Border>
                        <TextBlock Text="{Binding FansPage.SourceText}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Fan curve" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Fan curve">
                    <local:CurveEditor x:Name="Curve" />
                </GroupBox>

                <GroupBox Header="AI assist" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="AI assist">
                    <StackPanel x:Name="AiHost" />
                </GroupBox>

                <GroupBox Header="Games" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Games"
                          Visibility="{Binding BetaGamesVisibility}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Ember switches to game mode when a full-screen program keeps your GPU busy. If it guesses wrong, mark the program as not a game." />
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding DetectedGameVisibility}">
                            <Button DockPanel.Dock="Right" Content="Not a game" Tag="{Binding FansPage.DetectedGame}" Click="OnNotAGame"
                                    Style="{StaticResource ActionButton}"
                                    AutomationProperties.Name="{Binding FansPage.DetectedGame, StringFormat=Mark {0} as not a game}" />
                            <TextBlock Text="{Binding FansPage.DetectedGame, StringFormat=Game detected: {0}}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Not games" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"
                                   Visibility="{Binding NotGamesVisibility}" />
                        <ItemsControl ItemsSource="{Binding FansPage.NotGames}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Undo" Tag="{Binding}" Click="OnUndoNotAGame"
                                                Style="{StaticResource ActionButton}"
                                                AutomationProperties.Name="{Binding StringFormat=Treat {0} as a game again}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                
            </StackPanel>
        </ScrollViewer>

        <!-- Lights -->
        <ScrollViewer x:Name="LightsPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <local:LightsPage x:Name="Lights" />
        </ScrollViewer>

        <!-- Devices -->
        <ScrollViewer x:Name="DevicesPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <StackPanel>
            <local:DevicesPage x:Name="Devices" />
            <GroupBox Header="Fan headers" Style="{StaticResource Panel}" Margin="24,-8,24,24" AutomationProperties.Name="Fan headers">
                    <StackPanel>
                        <CheckBox Content="Allow Ember to control the GPU fan (optional, test it first)" IsChecked="{Binding FansPage.GpuControl, Mode=OneWay}"
                                  Click="OnGpuControl" Style="{StaticResource SwitchBox}" Margin="0,0,0,8"
                                  Visibility="{Binding BetaGpuVisibility}" />
                        <TextBlock Text="No fan headers reported" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding NoHeadersVisibility}" />
                        <ItemsControl ItemsSource="{Binding FansPage.Headers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Test" Tag="{Binding Id}" Click="OnTestHeader" IsEnabled="{Binding CanTest}"
                                                    Style="{StaticResource ActionButton}" ToolTip="{Binding DisabledReason}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Test {0}}"
                                                    AutomationProperties.HelpText="{Binding DisabledReason}" />
                                            <Button Content="Enable" Tag="{Binding Id}" Click="OnEnableHeader" IsEnabled="{Binding CanEnable}"
                                                    Style="{StaticResource ActionButton}" ToolTip="{Binding DisabledReason}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}"
                                                    AutomationProperties.HelpText="{Binding DisabledReason}" />
                                            <Button Content="Disable" Tag="{Binding Id}" Click="OnDisableHeader" IsEnabled="{Binding CanDisable}"
                                                    Style="{StaticResource ActionButton}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Disable {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="This board cannot hand a fan back to automatic control while Windows is running. When Ember stops it leaves each system fan at its saved speed and the CPU fan at 100% until you restart the PC. The pump is left to the board." />
                        <TextBlock x:Name="TestLabel" Text="{Binding FansPage.TestMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ActionLabel" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <Grid Margin="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,48,16,0">
                <RadioButton x:Name="SetGeneral" GroupName="SettingsNav" Content="General" Tag="general" IsChecked="True" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Appearance" Tag="appearance" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Fan control" Tag="fan" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Lighting" Tag="lights" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Updates" Tag="updates" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="What's new" Tag="changelog" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Roadmap" Tag="roadmap" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Legal" Tag="legal" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="About" Tag="about" Style="{StaticResource NavItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
              </StackPanel>
              <StackPanel x:Name="SettingsSections" Grid.Column="1" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"
                           AutomationProperties.HeadingLevel="Level2" />

                <GroupBox Tag="general" Header="Temperature unit" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Temperature unit">
                    <StackPanel>
                        <Border Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Unit" Content="Celsius (°C)" Tag="Celsius" Click="OnUnitPicked"
                                             IsChecked="{Binding UseCelsius, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Unit" Content="Fahrenheit (°F)" Tag="Fahrenheit" Click="OnUnitPicked"
                                             IsChecked="{Binding UseFahrenheit, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Used for the numbers and the temperature history. The fan curves are always drawn in °C." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Tag="general" Header="When Ember opens" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="When Ember opens">
                    <StackPanel>
                        <Border Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="StartPage" Content="Dashboard" Tag="Dashboard" Click="OnStartPagePicked"
                                             IsChecked="{Binding StartOnDashboard, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="StartPage" Content="Fans" Tag="Fans" Click="OnStartPagePicked"
                                             IsChecked="{Binding StartOnFans, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="StartupSwitch" Content="Start Ember when I sign in to Windows" Click="OnStartupToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <CheckBox x:Name="TraySwitch" Content="Keep running in the tray when I close the window" Click="OnTrayToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <CheckBox x:Name="MinimisedSwitch" Content="Start minimised, in the tray" Click="OnMinimisedToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="This only opens the window. Fan control runs in the Ember service, which starts with Windows whether or not the window is open." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Tag="appearance" Header="Theme" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Theme">
                    <StackPanel>
                        <Border Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Theme" Content="Dark" Tag="Dark" Click="OnThemePicked" IsChecked="{Binding ThemeDark, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Theme" Content="Light" Tag="Light" Click="OnThemePicked" IsChecked="{Binding ThemeLight, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Theme" Content="Match Windows" Tag="System" Click="OnThemePicked" IsChecked="{Binding ThemeSystem, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
                <GroupBox Tag="appearance" Header="Accent colour" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Accent colour">
                    <StackPanel x:Name="AccentRow" Orientation="Horizontal" />
                </GroupBox>
                <GroupBox Tag="fan" Header="Fan control" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Fan control">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding ConnectionText}" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Fan modes, curves and which headers Ember controls are kept by the service and are set on the Fans page. The safety rules (90 °C override, early CPU ramp, speed floors) cannot be switched off." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Open settings folder" Click="OnOpenSettingsFolder" Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                            <Button Content="Restart as administrator" Click="OnRestartAsAdmin" Style="{StaticResource ActionButton}" Margin="0"
                                    Visibility="{Binding NotElevatedVisibility}"
                                    ToolTip="Needed to close fan-control programs that run as administrator." />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Tag="fan"><GroupBox Header="Experimental" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Experimental features"
                          Visibility="{Binding ExperimentalAvailableVisibility}">
                    <StackPanel>
                        <CheckBox x:Name="ExperimentalSwitch" Content="Turn on experimental features" Click="OnExperimentalToggled"
                                  IsChecked="{Binding FansPage.Experimental, Mode=OneWay}" Style="{StaticResource SwitchBox}" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Game detection switches the fan mode to your game mode while a full-screen program keeps the GPU busy, and lets you mark programs as not a game. GPU fan control lets Ember drive the graphics card fan once you have tested it. Both are still being proven on real hardware, so they are off until you turn them on. Turning this off ends any game mode and hands the GPU fan back to the card." />
                    </StackPanel>
                </GroupBox></StackPanel>

                <GroupBox Tag="lights" Header="Govee" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Govee lamps">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Lamps are found on your network when LAN control is switched on for them in the Govee app. An API key is only needed for lamps that cannot do that; they are reached through Govee's cloud and follow slow changes only." />
                        <WrapPanel Margin="0,10,0,0">
                            <PasswordBox x:Name="GoveeKey" Width="320" Padding="10,6" Margin="0,0,8,6" MaxLength="200"
                                         AutomationProperties.Name="Govee API key" />
                            <Button Content="Save key" Click="OnSaveGoveeKey" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Test key" Click="OnTestGoveeKey" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Remove key" Click="OnRemoveGoveeKey" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="GoveeNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Tag="lights" Header="Philips Hue" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Philips Hue">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Ember talks to your Hue bridge directly on your home network: no Hue account and no cloud. Type the bridge address (or press Find bridge), press the round button on top of the bridge, then press Link bridge within 30 seconds. The key the bridge gives is kept in Windows Credential Manager. Hue lights follow the scene as one colour each, a few times a second." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBox x:Name="HueHost" Width="220" Style="{StaticResource TextField}" Margin="0,0,8,6" MaxLength="100"
                                     AutomationProperties.Name="Hue bridge address" />
                            <Button Content="Find bridge" Click="OnHueFind" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Link bridge" Click="OnHueLink" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Unlink" Click="OnHueUnlink" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="HueNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Tag="updates" Header="Updates" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Updates">
                    <StackPanel>
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="A check only asks GitHub for the list of releases. When a newer one exists, Update now downloads its installer, checks it against the release checksum and starts it. Nothing is downloaded or installed until you press the button." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Check now" Click="OnCheckUpdates" Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                            <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNow" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Visibility="Collapsed" />
                            <Button x:Name="OpenReleaseButton" Content="Open release page" Click="OnOpenRelease" Style="{StaticResource ActionButton}" Margin="0" Visibility="Collapsed" />
                        </WrapPanel>
                        <TextBlock x:Name="UpdateNote" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                        <CheckBox Content="Check for updates when Ember starts" Click="OnAutoUpdateToggled" IsChecked="{Binding AutoCheckUpdates, Mode=OneWay}"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <TextBlock Text="Release channel" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6" />
                        <Border Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Channel" Content="Stable" Tag="Stable" Click="OnChannelPicked" IsChecked="{Binding ChannelStable, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Channel" Content="Beta" Tag="Beta" Click="OnChannelPicked" IsChecked="{Binding ChannelBeta, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Beta also offers pre-releases, which get new features earlier and may have more bugs." />
                    </StackPanel>
                </GroupBox>
                <GroupBox Tag="changelog" Header="What's new" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Changelog">
                    <StackPanel x:Name="ChangelogHost" />
                </GroupBox>
                <GroupBox Tag="roadmap" Header="Roadmap" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Roadmap">
                    <StackPanel x:Name="RoadmapHost" />
                </GroupBox>
                <GroupBox Tag="legal" Header="Legal" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Legal">
                    <StackPanel x:Name="LegalHost" />
                </GroupBox>
                <GroupBox Tag="about" Header="About" Style="{StaticResource Panel}" AutomationProperties.Name="About Ember">
                    <StackPanel>
                        <TextBlock Text="{Binding BuildLabel}" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Ember monitors your PC's temperatures and fans and controls the fans on supported motherboards. Game detection and GPU fan control arrive in the beta build." />
                        <TextBlock x:Name="SettingsNote" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
