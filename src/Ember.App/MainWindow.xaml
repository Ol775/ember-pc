<Window x:Class="Ember.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ember.App"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Ember" Icon="Assets/ember.ico" Width="1100" Height="720" MinWidth="820" MinHeight="560"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <!-- A fan header in the narrow right-hand column of the redesigned Fans page. -->
        <DataTemplate x:Key="FanHeaderCompact">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelBorderBrush}" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,8,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Test" Tag="{Binding Id}" Click="OnTestHeader" IsEnabled="{Binding CanTest}" Padding="16,7"
                            Style="{StaticResource ActionButton}" ToolTip="{Binding DisabledReason}" Margin="0,0,12,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name, StringFormat=Test {0}}" AutomationProperties.HelpText="{Binding DisabledReason}" />
                    <CheckBox Grid.Column="2" Style="{StaticResource SwitchBox}" Tag="{Binding Id}" Click="OnHeaderSwitch" VerticalAlignment="Center"
                              IsChecked="{Binding CanDisable, Mode=OneWay}" ToolTip="{Binding DisabledReason}"
                              AutomationProperties.Name="{Binding Name, StringFormat=Let Ember control {0}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel x:Name="SidebarDock" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <StackPanel x:Name="LogoRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,24">
                <Path x:Name="LogoPath" Data="M12,3 C13,7 17,8 17,13 A5,5 0 0 1 7,13 C7,11 8,10 9,9 C9,11 10,12 11,12 C11,9 10,7 12,3 Z"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" Width="24" Height="24"
                      Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Ember" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>
            <StackPanel x:Name="ConnectionRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20,0,20,20">
                <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="ConnectionLabel" Text="{Binding ConnectionText}" Foreground="{DynamicResource MutedBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock x:Name="BuildLabelText" DockPanel.Dock="Bottom" Text="{Binding BuildLabel}" Foreground="{DynamicResource MutedBrush}" Margin="20,0,20,12" />
            <Button x:Name="RestartAdminButton" DockPanel.Dock="Bottom" Content="Restart as admin" Click="OnRestartAsAdmin" Margin="20,0,20,12"
                    Style="{StaticResource ActionButton}" Visibility="{Binding NotElevatedVisibility}"
                    ToolTip="Needed to close fan-control programs that run as administrator." />
            <StackPanel VerticalAlignment="Top">
                <RadioButton x:Name="NavDashboard" GroupName="Nav" Content="Dashboard" local:Nav.Icon="M3 3h7v9H3z M14 3h7v5h-7z M14 12h7v9h-7z M3 16h7v5H3z" IsChecked="True"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavFans" GroupName="Nav" Content="Fans" local:Nav.Icon="M10 12a2 2 0 1 0 4 0 2 2 0 1 0-4 0 M12 10c0-4 1-7 4-7 2 0 3 2 1 4l-5 3 M14 12c4 0 7 1 7 4 0 2-2 3-4 1l-3-5 M12 14c0 4-1 7-4 7-2 0-3-2-1-4l5-3 M10 12c-4 0-7-1-7-4 0-2 2-3 4-1l3 5"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavLights" GroupName="Nav" Content="Lights" local:Nav.Icon="M9 18h6 M10 21h4 M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavDevices" GroupName="Nav" Content="Devices" local:Nav.Icon="M9 3v5 M15 3v5 M6 8h12v4a6 6 0 0 1-12 0z M12 18v3"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavGames" GroupName="Nav" Content="Games" local:Nav.Icon="M7 7h10a5.5 5.5 0 0 1 0 11H7A5.5 5.5 0 0 1 7 7z M7 10v5 M4.5 12.5h5 M16 11h.01 M18 14h.01"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavPower" GroupName="Nav" Content="Power" local:Nav.Icon="M13 2 4 14h7l-1 8 9-12h-7z"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavSpecs" GroupName="Nav" Content="Specs" local:Nav.Icon="M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M9 2v4 M15 2v4 M9 18v4 M15 18v4 M2 9h4 M2 15h4 M18 9h4 M18 15h4"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavSettings" GroupName="Nav" Content="Settings" local:Nav.Icon="M15 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0z M12 2v3 M12 19v3 M2 12h3 M19 12h3 M5 5l2 2 M17 17l2 2 M19 5l-2 2 M7 17l-2 2"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" />
            </StackPanel>
        </DockPanel>

        <!-- Dashboard -->
        <ScrollViewer x:Name="DashboardPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24">
                <DockPanel Margin="0,0,0,16">
                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14"
                            Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeChipText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>

                <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding DriverBannerVisibility}">
                    <TextBlock x:Name="BannerLabel" Text="{Binding DriverBannerText}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <TextBlock Text="Sensor data is stale" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding StaleNoteVisibility}" AutomationProperties.LiveSetting="Polite" />

                <UniformGrid Columns="4" Margin="-6,0,-6,16">
                    <GroupBox Header="CPU" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding CpuText, StringFormat=CPU temperature {0}}">
                        <StackPanel><TextBlock Text="{Binding CpuText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding CpuSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                    <GroupBox Header="GPU" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding GpuText, StringFormat=GPU temperature {0}}">
                        <StackPanel><TextBlock Text="{Binding GpuText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource GpuBrush}" /><TextBlock Text="{Binding GpuSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                    <GroupBox Header="Motherboard" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding MotherboardText, StringFormat=Motherboard temperature {0}}">
                        <StackPanel><TextBlock Text="{Binding MotherboardText}" Style="{StaticResource StatValue}" /><TextBlock Text="{Binding MotherboardSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                    <GroupBox Header="Fans (average)" Style="{StaticResource Panel}" Margin="6"
                              AutomationProperties.Name="{Binding FanAverageText, StringFormat=Fans average {0}}">
                        <StackPanel><TextBlock Text="{Binding FanAverageText}" Style="{StaticResource StatValue}" /><TextBlock Text="{Binding FansSub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </GroupBox>
                </UniformGrid>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="{Binding ChartTitle}" Style="{StaticResource Panel}" Margin="0,0,16,0">
                    <AutomationProperties.Name>
                        <MultiBinding StringFormat="Temperature history chart, last 10 minutes. CPU now {0}, GPU now {1}">
                            <Binding Path="CpuText" />
                            <Binding Path="GpuText" />
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Rectangle Width="14" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="CPU" Margin="6,0,16,0" />
                            <Rectangle Width="14" Height="3" Fill="{DynamicResource GpuBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU" Margin="6,0,0,0" />
                        </StackPanel>
                        <Canvas x:Name="HistoryCanvas" Height="260" ClipToBounds="True" SizeChanged="OnChartSizeChanged">
                            <Polyline Points="{Binding CpuLine}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" />
                            <Polyline Points="{Binding GpuLine}" Stroke="{DynamicResource GpuBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" />
                        </Canvas>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Fans" Style="{StaticResource Panel}" AutomationProperties.Name="Fans">
                    <StackPanel>
                        <TextBlock Text="No fan readings" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding NoFansVisibility}" />
                        <ItemsControl ItemsSource="{Binding Fans}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,6" Height="6" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelBorderBrush}"
                                                     BorderThickness="0" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding Name}"
                                                     AutomationProperties.HelpText="{Binding RpmText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RpmText}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Dashboard of the redesign (beta builds): replaces the classic one -->
        <ScrollViewer x:Name="NewDashboardPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
            <local:NewDashboard x:Name="NewDash" />
        </ScrollViewer>

        <!-- Fans -->
        <ScrollViewer x:Name="FansPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <StackPanel Margin="24">
                <TextBlock x:Name="FansHeading" Text="Fans" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"
                           AutomationProperties.HeadingLevel="Level2" />

                <TextBlock Text="{Binding FansPage.Message}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                           Visibility="{Binding FansMessageVisibility}" AutomationProperties.LiveSetting="Polite" />

                <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding CompetitorVisibility}">
                    <StackPanel>
                        <TextBlock x:Name="CompetitorLabel" Text="{Binding FansPage.CompetitorWarning}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Close these apps" Click="OnCloseCompetitors" Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,0" AutomationProperties.Name="Close the detected fan-control apps" />
                            <Button Content="Restart Ember as administrator" Click="OnRestartAsAdmin" Style="{StaticResource ActionButton}"
                                    Margin="0" Visibility="{Binding NotElevatedVisibility}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding SafetyVisibility}">
                    <TextBlock Text="{Binding FansPage.SafetyNote}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <GroupBox x:Name="ModePanelBox" Header="Mode" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Fan mode">
                    <StackPanel x:Name="ModePanelStack">
                        <Border x:Name="ModeTrack" Style="{StaticResource SegmentTrack}">
                        <ItemsControl ItemsSource="{Binding FansPage.Modes}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton x:Name="ModeRadio" GroupName="FanMode" Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}"
                                                 IsEnabled="{Binding Enabled}" Tag="{Binding Mode}" Click="OnModePicked"
                                                 Style="{StaticResource Segment}" />
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Mode}" Value="Ai" />
                                                <Condition Binding="{Binding Enabled}" Value="False" />
                                                <Condition Binding="{Binding Selected}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ModeRadio" Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Border>
                        <TextBlock x:Name="ModeSourceText" Text="{Binding FansPage.SourceText}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="FanCurvePanel" Header="Fan curve" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Fan curve">
                    <local:CurveEditor x:Name="Curve" />
                </GroupBox>

                <GroupBox x:Name="AiPanelBox" Header="AI assist" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="AI assist">
                    <StackPanel x:Name="AiHost" />
                </GroupBox>

                <GroupBox x:Name="GamesPanelBox" Header="Games (beta)" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Games"
                          Visibility="{Binding BetaGamesVisibility}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Ember switches to game mode when a game from your launcher libraries runs (see the Games page) or a full-screen program keeps your GPU busy. If it guesses wrong, mark the program as not a game." />
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding DetectedGameVisibility}">
                            <Button DockPanel.Dock="Right" Content="Not a game" Tag="{Binding FansPage.DetectedGame}" Click="OnNotAGame"
                                    Style="{StaticResource ActionButton}"
                                    AutomationProperties.Name="{Binding FansPage.DetectedGame, StringFormat=Mark {0} as not a game}" />
                            <TextBlock Text="{Binding FansPage.DetectedGame, StringFormat=Game detected: {0}}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Not games" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"
                                   Visibility="{Binding NotGamesVisibility}" />
                        <ItemsControl ItemsSource="{Binding FansPage.NotGames}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Undo" Tag="{Binding}" Click="OnUndoNotAGame"
                                                Style="{StaticResource ActionButton}"
                                                AutomationProperties.Name="{Binding StringFormat=Treat {0} as a game again}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                
            </StackPanel>
        </ScrollViewer>

        <!-- Lights -->
        <ScrollViewer x:Name="LightsPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <local:LightsPage x:Name="Lights" />
        </ScrollViewer>

        <!-- Games -->
        <ScrollViewer x:Name="GamesPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <local:GamesPage x:Name="Games" />
        </ScrollViewer>

        <!-- Specs -->
        <ScrollViewer x:Name="SpecsPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <local:SpecsPage x:Name="Specs" />
        </ScrollViewer>

        <!-- Power -->
        <ScrollViewer x:Name="PowerPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <local:PowerPage x:Name="Power" />
        </ScrollViewer>

        <!-- Devices -->
        <ScrollViewer x:Name="DevicesPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <StackPanel>
            <local:DevicesPage x:Name="Devices" />
            <GroupBox x:Name="FanHeadersPanel" Header="Fan headers" Style="{StaticResource Panel}" Margin="24,-8,24,24" AutomationProperties.Name="Fan headers">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding FansPage.GpuControl, Mode=OneWay}"
                                  Click="OnGpuControl" Style="{StaticResource SwitchBox}" Margin="0,0,0,8"
                                  Visibility="{Binding BetaGpuVisibility}">
                            <TextBlock Text="Allow Ember to control the GPU fan (optional, test it first)" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="No fan headers reported" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding NoHeadersVisibility}" />
                        <ItemsControl x:Name="FanHeadersList" ItemsSource="{Binding FansPage.Headers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Test" Tag="{Binding Id}" Click="OnTestHeader" IsEnabled="{Binding CanTest}"
                                                    Style="{StaticResource ActionButton}" ToolTip="{Binding DisabledReason}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Test {0}}"
                                                    AutomationProperties.HelpText="{Binding DisabledReason}" />
                                            <Button Content="Enable" Tag="{Binding Id}" Click="OnEnableHeader" IsEnabled="{Binding CanEnable}"
                                                    Style="{StaticResource ActionButton}" ToolTip="{Binding DisabledReason}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}"
                                                    AutomationProperties.HelpText="{Binding DisabledReason}" />
                                            <Button Content="Disable" Tag="{Binding Id}" Click="OnDisableHeader" IsEnabled="{Binding CanDisable}"
                                                    Style="{StaticResource ActionButton}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Disable {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="This board cannot hand a fan back to automatic control while Windows is running. When Ember stops it leaves each system fan at its saved speed and the CPU fan at 100% until you restart the PC. The pump is left to the board." />
                        <TextBlock x:Name="TestLabel" Text="{Binding FansPage.TestMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ActionLabel" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPageView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
            <Grid Margin="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,48,16,0">
                <RadioButton x:Name="SetGeneral" GroupName="SettingsNav" Content="General" Tag="general" IsChecked="True" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Appearance" Tag="appearance" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Fan control" Tag="fan" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Lighting" Tag="lights" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton x:Name="NavAutomation" GroupName="SettingsNav" Content="Schedule and alerts" Tag="automation" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="What's new" Tag="changelog" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton x:Name="NavRoadmap" GroupName="SettingsNav" Content="Roadmap" Tag="roadmap" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Legal" Tag="legal" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="Updates" Tag="updates" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
                <RadioButton GroupName="SettingsNav" Content="About" Tag="about" Style="{StaticResource SectionItem}" Margin="0,0,0,4" Checked="OnSettingsSection" />
              </StackPanel>
              <StackPanel x:Name="SettingsSections" Grid.Column="1" MaxWidth="720" HorizontalAlignment="Stretch">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" x:Name="SettingsHeading"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="SettingsSub" Text="Make Ember look and behave the way you like. Changes apply at once." Foreground="{DynamicResource MutedBrush}" Margin="0,-12,0,16" TextWrapping="Wrap" Visibility="Collapsed" />

                <GroupBox Tag="general" Header="Temperature unit" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Temperature unit">
                    <StackPanel>
                        <Border x:Name="UnitTrack" Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Unit" Content="Celsius (°C)" Tag="Celsius" Click="OnUnitPicked"
                                             IsChecked="{Binding UseCelsius, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Unit" Content="Fahrenheit (°F)" Tag="Fahrenheit" Click="OnUnitPicked"
                                             IsChecked="{Binding UseFahrenheit, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Used for the numbers and the temperature history. The fan curves are always drawn in °C." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Tag="general" Header="When Ember opens" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="When Ember opens">
                    <StackPanel>
                        <Border x:Name="StartPageTrack" Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="StartPage" Content="Dashboard" Tag="Dashboard" Click="OnStartPagePicked"
                                             IsChecked="{Binding StartOnDashboard, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="StartPage" Content="Fans" Tag="Fans" Click="OnStartPagePicked"
                                             IsChecked="{Binding StartOnFans, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="StartPage" Content="Lights" Tag="Lights" Click="OnStartPagePicked"
                                             IsChecked="{Binding StartOnLights, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="StartPage" Content="Devices" Tag="Devices" Click="OnStartPagePicked"
                                             IsChecked="{Binding StartOnDevices, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="StartupSwitch" Content="Start Ember when I sign in to Windows" Click="OnStartupToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <CheckBox x:Name="TraySwitch" Content="Keep running in the tray when I close the window" Click="OnTrayToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <CheckBox x:Name="MinimisedSwitch" Content="Start minimised, in the tray" Click="OnMinimisedToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <CheckBox x:Name="RememberWindowSwitch" Content="Open the window where I left it (size and position)" Click="OnRememberWindowToggled"
                                  Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="This only opens the window. Fan control runs in the Ember service, which starts with Windows whether or not the window is open." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Tag="appearance" Header="Theme" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Theme">
                    <StackPanel x:Name="ThemeHost" />
                </GroupBox>
                <GroupBox Tag="appearance" Header="Colour scheme" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Colour scheme">
                    <StackPanel x:Name="ToneHost" />
                </GroupBox>
                <GroupBox Tag="appearance" Header="Accent colour" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Accent colour">
                    <StackPanel x:Name="AccentHost" />
                </GroupBox>
                <GroupBox Tag="appearance" Header="Highlights" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Highlights">
                    <StackPanel x:Name="HighlightHost" />
                </GroupBox>
                <GroupBox Tag="appearance" Header="Interface size" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Interface size">
                    <StackPanel x:Name="SizeHost" />
                </GroupBox>
                <GroupBox Tag="appearance" Header="GPU colour" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="GPU colour">
                    <StackPanel x:Name="GpuHost" />
                </GroupBox>
                <GroupBox x:Name="FanControlBox" Tag="fan" Header="Fan control" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Fan control">
                    <StackPanel>
                        <TextBlock x:Name="FanConnectionText" TextWrapping="Wrap" Text="{Binding ConnectionText}" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Fan modes, curves and which headers Ember controls are kept by the service and are set on the Fans page. The safety rules (90 °C override, early CPU ramp, speed floors) cannot be switched off." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="OpenFolderButton" Content="Open settings folder" Click="OnOpenSettingsFolder" Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                            <Button x:Name="AdminButton" Content="Restart as administrator" Click="OnRestartAsAdmin" Style="{StaticResource ActionButton}" Margin="0"
                                    Visibility="{Binding NotElevatedVisibility}"
                                    ToolTip="Needed to close fan-control programs that run as administrator." />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Tag="fan"><GroupBox x:Name="ExperimentalBox" Header="Experimental" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Experimental features"
                          Visibility="{Binding ExperimentalAvailableVisibility}">
                    <StackPanel>
                        <CheckBox x:Name="ExperimentalSwitch" Content="Turn on experimental features" Click="OnExperimentalToggled"
                                  IsChecked="{Binding FansPage.Experimental, Mode=OneWay}" Style="{StaticResource SwitchBox}" />
                        <TextBlock x:Name="ExperimentalNote" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{Binding ExperimentalText}" />
                    </StackPanel>
                </GroupBox></StackPanel>

                <GroupBox Tag="lights" Header="Govee" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Govee lamps">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Lamps are found on your network when LAN control is switched on for them in the Govee app. An API key is only needed for lamps that cannot do that; they are reached through Govee's cloud and follow slow changes only." />
                        <WrapPanel Margin="0,10,0,0">
                            <PasswordBox x:Name="GoveeKey" Style="{StaticResource PasswordField}" Width="320" Padding="10,6" Margin="0,0,8,6" MaxLength="200"
                                         AutomationProperties.Name="Govee API key" />
                            <Button Content="Save key" Click="OnSaveGoveeKey" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Test key" Click="OnTestGoveeKey" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Remove key" Click="OnRemoveGoveeKey" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="GoveeNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="HueBox" Tag="lights" Header="Philips Hue" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Philips Hue">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Ember talks to your Hue bridge directly on your home network: no Hue account and no cloud. Type the bridge address (or press Find bridge), press the round button on top of the bridge, then press Link bridge within 30 seconds. The key the bridge gives is kept in Windows Credential Manager. Hue lights follow the scene as one colour each, a few times a second." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBox x:Name="HueHost" Width="220" Style="{StaticResource TextField}" Tag="Bridge address" Margin="0,0,8,6" MaxLength="100"
                                     AutomationProperties.Name="Hue bridge address" />
                            <Button Content="Find bridge" Click="OnHueFind" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Link bridge" Click="OnHueLink" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Unlink" Click="OnHueUnlink" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="HueNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="NanoleafBox" Tag="lights" Header="Nanoleaf (beta)" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Nanoleaf">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Ember talks to your Nanoleaf controller directly on your home network: no account and no cloud. Type its address (or press Find controller), hold the power button on the controller for 5 to 7 seconds until it flashes, then press Link within 30 seconds. The token it gives is kept in Windows Credential Manager. Each panel is one light, ordered left to right, so effects run across the panels." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBox x:Name="NanoleafHost" Width="220" Style="{StaticResource TextField}" Tag="Controller address" Margin="0,0,8,6" MaxLength="100"
                                     AutomationProperties.Name="Nanoleaf controller address" />
                            <Button Content="Find controller" Click="OnNanoleafFind" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Link" Click="OnNanoleafLink" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Unlink" Click="OnNanoleafUnlink" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="NanoleafNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="MerossBox" Tag="lights" Header="Meross (beta)" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Meross">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Sign in with your Meross account once. Ember asks Meross only for your device list and the key your devices check commands against; it then finds the bulbs and light strips on this network and controls them directly, with no cloud in between. Plugs, hubs and thermostats are ignored. Your password is not saved: only the sign-in Meross hands back is kept, in Windows Credential Manager. If your account uses two-step verification, type the current code from your authenticator app in the code box. Bulbs follow the scene as one colour, a little over once a second. Nothing is switched until you place the device on the Lights page." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBox x:Name="MerossEmail" Width="220" Style="{StaticResource TextField}" Tag="Meross email" Margin="0,0,8,6" MaxLength="200"
                                     AutomationProperties.Name="Meross email" />
                            <PasswordBox x:Name="MerossPassword" Style="{StaticResource PasswordField}" Width="220" Padding="10,6" Margin="0,0,8,6" MaxLength="200"
                                         AutomationProperties.Name="Meross password" />
                            <TextBox x:Name="MerossCode" Width="150" Style="{StaticResource TextField}" Tag="Two-step code (if any)" Margin="0,0,8,6" MaxLength="10"
                                     AutomationProperties.Name="Meross two-step code" />
                            <Button Content="Sign in" Click="OnMerossSignIn" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Sign out" Click="OnMerossSignOut" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="MerossNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="ScheduleBox" Tag="automation" Header="Schedule" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Schedule">
                    <StackPanel x:Name="ScheduleHost" />
                </GroupBox>
                <GroupBox x:Name="AlertsBox" Tag="automation" Header="Alerts" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Alerts">
                    <StackPanel x:Name="AlertsHost" />
                </GroupBox>
                <GroupBox x:Name="TapoBox" Tag="lights" Header="Tapo / TP-Link (beta)" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Tapo">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Type the email and password of your Tapo account. Ember uses them only to sign in to your Tapo devices on this network, directly, with no cloud in between, and keeps them in Windows Credential Manager. Ember finds Tapo bulbs and light strips and lights them with the scene. Smart plugs are listed on the Power page and are only read, never switched. In the Tapo app, switch on Third-Party Compatibility for your devices if they are not found." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBox x:Name="TapoEmail" Width="220" Style="{StaticResource TextField}" Tag="Tapo email" Margin="0,0,8,6" MaxLength="200"
                                     AutomationProperties.Name="Tapo email" />
                            <PasswordBox x:Name="TapoPassword" Style="{StaticResource PasswordField}" Width="220" Padding="10,6" Margin="0,0,8,6" MaxLength="200"
                                         AutomationProperties.Name="Tapo password" />
                            <Button Content="Save" Click="OnTapoSave" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                            <Button Content="Remove" Click="OnTapoRemove" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock x:Name="TapoNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="RazerBox" Tag="lights" Header="Razer Chroma (beta)" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Razer Chroma">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Lights Razer keyboards, keypads, mousepads, headsets and Chroma Link strips through Razer Synapse on this PC (its local Chroma SDK; nothing leaves the PC). Razer Synapse must be running with Chroma Connect on. Ember cannot tell which Razer devices are plugged in, so switch off the ones you do not have on the Devices page. Razer mice are not used." />
                        <CheckBox x:Name="RazerSwitch" Content="Use Razer Chroma" Click="OnRazerToggled" Style="{StaticResource SwitchBox}" Margin="0,12,0,0" />
                        <TextBlock x:Name="RazerNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="UpdatesBox" Tag="updates" Header="Updates" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Updates">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="VersionBlock" Text="{Binding VersionText}" FontSize="20" FontWeight="SemiBold" />
                                <StackPanel x:Name="UpdateStatusRow" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="UpdateDot" Width="9" Height="9" Margin="0,2,8,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="UpdateNote" Text="Not checked yet." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="CheckNowButton" Grid.Column="1" Content="Check now" Click="OnCheckUpdates" Style="{StaticResource ActionButton}" Margin="12,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                        <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,16,0,0" Padding="16,14" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel>
                                <TextBlock x:Name="UpdateBannerTitle" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="UpdateNotes" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNow" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <Button x:Name="OpenReleaseButton" Content="Release page" Click="OnOpenRelease" Style="{StaticResource ActionButton}" Margin="0" Visibility="Collapsed" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,18,0,14" />
                        <CheckBox x:Name="AutoUpdateSwitch" Content="Check for updates automatically (at start, then every few hours)" Click="OnAutoUpdateToggled" IsChecked="{Binding AutoCheckUpdates, Mode=OneWay}"
                                  Style="{StaticResource SwitchBox}" />
                        <TextBlock x:Name="ChannelLabel" Text="Release channel" Margin="0,16,0,6" />
                        <Border x:Name="ChannelTrack" Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Channel" Content="Stable" Tag="Stable" Click="OnChannelPicked" IsChecked="{Binding ChannelStable, Mode=OneWay}" Style="{StaticResource Segment}" />
                                <RadioButton GroupName="Channel" Content="Beta" Tag="Beta" Click="OnChannelPicked" IsChecked="{Binding ChannelBeta, Mode=OneWay}" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ChannelNote" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Choosing a channel offers to switch this installation to that version of Ember (your settings are kept). Stable is the production build; Beta gets new features earlier, and more bugs." />
                        <TextBlock x:Name="UpdatePrivacyNote" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="Ember contacts GitHub only when it checks and when you press Update now. The installer is verified against the checksum published with the release before it runs." />
                    </StackPanel>
                </GroupBox>
                <GroupBox Tag="changelog" Header="What's new" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Changelog">
                    <StackPanel x:Name="ChangelogHost" />
                </GroupBox>
                <GroupBox x:Name="RoadmapBox" Tag="roadmap" Header="Roadmap" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Roadmap">
                    <StackPanel x:Name="RoadmapHost" />
                </GroupBox>
                <GroupBox Tag="legal" Header="Legal" Style="{StaticResource Panel}" Margin="0,0,0,16" AutomationProperties.Name="Legal">
                    <StackPanel x:Name="LegalHost" />
                </GroupBox>
                <GroupBox Tag="about" Header="About" Style="{StaticResource Panel}" AutomationProperties.Name="About Ember">
                    <StackPanel>
<StackPanel x:Name="AboutHost" />
                        <TextBlock x:Name="SettingsNote" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
