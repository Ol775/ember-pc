<!-- The redesign, beta builds only: rounder cards with small capital headings, and a sidebar with an icon on every page.
     App.OnStartup swaps these styles in for the ones in App.xaml before the window is made. References are dynamic because
     this dictionary is loaded on its own, before it joins the application resources. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ember.App">

    <local:UpperCaseConverter x:Key="UpperCase" />

    <Style x:Key="Panel" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="18" Padding="20,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperCase}}"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                            <ContentPresenter Margin="0,8,0,0" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="10,0,10,3" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bar" Padding="12,10" CornerRadius="10" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Data="{Binding (local:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TrackBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
